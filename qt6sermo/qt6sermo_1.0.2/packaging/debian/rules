#!/usr/bin/make -f
# debian/rules — qt6sermo 1.0.0 (haplo-dialog) — CMake build

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release

override_dh_auto_install:
	dh_auto_install
	install -d $(CURDIR)/debian/qt6sermo/usr/share/doc/qt6sermo/examples
	cp -r examples/* $(CURDIR)/debian/qt6sermo/usr/share/doc/qt6sermo/examples/ 2>/dev/null || true
	# Lanceur .desktop (masqué) et métadonnées AppStream — aussi installés par le build amont
	install -D -m644 data/qt6sermo.desktop $(CURDIR)/debian/qt6sermo/usr/share/applications/qt6sermo.desktop
	install -D -m644 data/fr.haplo_dialog.qt6sermo.metainfo.xml $(CURDIR)/debian/qt6sermo/usr/share/metainfo/fr.haplo_dialog.qt6sermo.metainfo.xml

override_dh_auto_test:
	# Suite de tests (Check) désactivée à l'empaquetage — dépendance facultative.

override_dh_icons:
	rm -f $(CURDIR)/debian/qt6sermo/usr/share/icons/hicolor/icon-theme.cache
	dh_icons
