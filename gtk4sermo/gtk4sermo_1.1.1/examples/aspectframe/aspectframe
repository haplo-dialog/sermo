#!/bin/sh
# gtkdialog4 example: aspectframe widget
GTKDIALOG=${GTKDIALOG:-gtk4sermo}

MAIN_DIALOG='
<window title="Cadre proportionnel" border-width="12">
  <vbox spacing="10">
    <text><label>GtkAspectFrame — ratio 16:9 :</label></text>
    <aspectframe ratio="1.777" xalign="0.5" yalign="0.5">
      <vbox>
        <text><label>Contenu en 16:9</label></text>
        <button><label>Bouton centré</label></button>
      </vbox>
      <variable>AF_MAIN</variable>
    </aspectframe>
    <hbox homogeneous="true">
      <button ok></button>
    </hbox>
  </vbox>
</window>
'
export MAIN_DIALOG
case $1 in
  -d | --dump) echo "$MAIN_DIALOG" ;;
  *) $GTKDIALOG --program=MAIN_DIALOG ;;
esac
