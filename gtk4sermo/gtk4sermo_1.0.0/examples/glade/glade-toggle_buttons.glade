<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="toggle_window">
    <property name="title">GtkDialog Example</property>
    <child>
      <object class="GtkBox" id="vbox2">
        <property name="margin-end">5</property>
        <property name="margin-start">5</property>
        <property name="margin-bottom">5</property>
        <property name="margin-top">5</property>
        <property name="orientation">vertical</property>
        <property name="visible">True</property>
        <child>
          <object class="GtkNotebook" id="notebook1">
            <property name="visible">True</property>
            <child>
              <object class="GtkBox" id="vbox3">
                <property name="orientation">vertical</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkCheckButton" id="checkbutton1">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">This is the very first checkbutton</property>
                    <signal name="toggled" handler="echo checkbutton1 is $checkbutton1" />
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="checkbutton2">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">checkbutton</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="checkbutton3">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">checkbutton</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="checkbutton4">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">checkbutton</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="checkbutton5">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">checkbutton</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label5">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Check</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox4">
                <property name="orientation">vertical</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkCheckButton" id="radiobutton1">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">radiobutton</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton2">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">radiobutton</property>
                    <property name="group">radiobutton1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton3">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">radiobutton</property>
                    <property name="group">radiobutton2</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton4">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">radiobutton</property>
                    <property name="group">radiobutton3</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="radiobutton5">
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-bottom">5</property>
                    <property name="margin-top">5</property>
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">radiobutton</property>
                    <property name="group">radiobutton4</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label6">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Radio</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="table2">
                <property name="visible">True</property>
                <child>
                  <object class="GtkToggleButton" id="togglebutton1">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">togglebutton</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkColorButton" id="colorbutton1">
                    <property name="visible">True</property>
                    <property name="rgba">#000000000000</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkFontButton" id="fontbutton1">
                    <property name="visible">True</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label8">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Toggle:</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label9">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">File:</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label10">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Color:</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label11">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Font:</property>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">3</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="filechooserbutton1">
                    <property name="label">Choisir un fichier…</property>
                    <property name="visible">True</property>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">1</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label7">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Button</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbuttonbox2">
            <property name="spacing">6</property>
            <property name="halign">end</property>
            <property name="orientation">horizontal</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="toggle_window_close_button">
                <property name="margin-end">5</property>
                <property name="margin-start">5</property>
                <property name="margin-bottom">5</property>
                <property name="margin-top">5</property>
                <property name="visible">True</property>
                <property name="label" translatable="yes">Fermer</property>
                <signal name="clicked" handler="exit:Close" />
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
