<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="MAIN_WINDOW">
    <property name="width-request">300</property>
    <property name="title">GtkDialog Example</property>
    <property name="modal">False</property>
    <property name="resizable">True</property>
    <property name="decorated">True</property>
    <child>
      <object class="GtkBox" id="toolbar1">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <child>
          <object class="GtkButton" id="toolbutton1">
            <property name="icon-name">system-run</property>
            <property name="visible">True</property>
            <property name="tooltip-text" translatable="yes">Terminal emulator.</property>
            <property name="label" translatable="yes">Terminal</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="gnome-terminal&amp;" />
          </object>
        </child>
        <child>
          <object class="GtkButton" id="info_toolbutton">
            <property name="icon-name">dialog-information</property>
            <property name="visible">True</property>
            <property name="tooltip-text" translatable="yes">The devhelp documentation browser.</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="devhelp&amp;" />
          </object>
        </child>
        <child>
          <object class="GtkButton" id="home_toolbutton">
            <property name="icon-name">go-home</property>
            <property name="visible">True</property>
            <property name="tooltip-text" translatable="yes">The firefox web browser.</property>
            <property name="use-underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="filesystem_toolbutton">
            <property name="icon-name">folder</property>
            <property name="visible">True</property>
            <property name="tooltip-text" translatable="yes">The nautilus filemanager.</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="nautilus&amp;" />
          </object>
        </child>
        <child>
          <object class="GtkButton" id="editor_toolbutton">
            <property name="icon-name">text-x-generic</property>
            <property name="visible">True</property>
            <property name="tooltip-text" translatable="yes">The gvim text editor.</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="gvim" />
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="separatortoolitem1">
            <property name="orientation">vertical</property>
            <property name="visible">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="quit_toolbutton">
            <property name="icon-name">application-exit</property>
            <property name="visible">True</property>
            <property name="tooltip-text" translatable="yes">Quit this demo.</property>
            <property name="label" translatable="yes">Quit</property>
            <property name="use-underline">True</property>
            <signal name="clicked" handler="exit:Normal" />
          </object>
        </child>
        <style>
          <class name="toolbar" />
        </style>
      </object>
    </child>
  </object>
</interface>
