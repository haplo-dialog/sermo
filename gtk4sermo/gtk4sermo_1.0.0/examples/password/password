#!/bin/sh
# gtkdialog4 example: password widget
GTKDIALOG=gtkdialog4

MAIN_DIALOG='
<window title="Authentification" border-width="12">
  <vbox spacing="10">
    <hbox>
      <text><label>Utilisateur :</label></text>
      <entry><variable>ENT_USER</variable></entry>
    </hbox>
    <hbox>
      <text><label>Mot de passe :</label></text>
      <password>
        <variable>ENT_PASS</variable>
        <placeholder-text>Mot de passe…</placeholder-text>
      </password>
    </hbox>
    <hseparator></hseparator>
    <hbox homogeneous="true">
      <button ok></button>
      <button cancel></button>
    </hbox>
  </vbox>
</window>
'
export MAIN_DIALOG
case $1 in
  -d | --dump) echo "$MAIN_DIALOG" ;;
  *) $GTKDIALOG --program=MAIN_DIALOG ;;
esac
