    <text use-markup="true"><label>"<span font='Monospace 20' foreground='#1a5fb4'>cheval-tulipe-orage-piano-sable-yaourt</span>"</label></text>
    <hbox><text><label>Pour le copier :</label></text>
      <entry space-expand="true" space-fill="true"><variable>A_COPIER</variable><default>cheval-tulipe-orage-piano-sable-yaourt</default></entry></hbox>
