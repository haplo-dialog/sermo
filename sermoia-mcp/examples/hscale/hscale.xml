<window title="Glissiere horizontale" width-request="360">
  <vbox spacing="8">
    <text><label>Reglez la valeur, puis validez :</label></text>
    <hscale range-min="0" range-max="100" range-step="1" draw-value="true">
      <variable>VALEUR</variable>
      <default>50</default>
    </hscale>
    <button ok></button>
  </vbox>
</window>
