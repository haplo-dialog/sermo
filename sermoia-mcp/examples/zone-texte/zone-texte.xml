<window title="Éditeur de note" width-request="420" height-request="300">
  <vbox spacing="8">
    <text><label>Rédigez votre note :</label></text>
    <edit editable="true" wrap-mode="word">
      <variable>NOTE</variable>
      <default>Saisissez votre texte ici…</default>
    </edit>
    <hbox>
      <button><label>Enregistrer</label><action>EXIT:0</action></button>
      <button cancel></button>
    </hbox>
  </vbox>
</window>
