<window title="Liste simple" width-request="300" height-request="240">
  <vbox>
    <text><label>Choisissez une distribution :</label></text>
    <list scrollable="true">
      <variable>DISTRO</variable>
      <item>Debian</item>
      <item>Fedora</item>
      <item>Arch</item>
      <item>Ubuntu</item>
    </list>
    <button ok></button>
  </vbox>
</window>
