# Binaires produits — motifs **/src/ pour matcher à toute profondeur
# (les anciens motifs ancrés à la racine ne matchaient jamais les ports imbriqués)
# Noms courts hérités
**/src/gtk3d
# Noms complets uniformisés v1.0.0
**/src/gtkdialog
**/src/gtk3sermo

# CMake
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
_CPack_Packages/

# Fichiers générés par flex/bison
gtkdialog_lexer.c
gtkdialog_parser.c
gtkdialog_parser.h

# Archives dist
*.tar.gz
*.tar.xz
*.tar.bz2

# Paquets binaires (ne pas versionner — produits de release / deps externes)
*.deb
*.rpm
*.pkg.tar.zst
dist/

# Packaging temporaire
packaging/debian/gtk3d/
packaging/debian/files
packaging/debian/*.debhelper
packaging/debian/*.substvars
packaging/debian/.debhelper/

# Éditeurs
*.swp
*.swo
*~
.vscode/
.idea/
*.orig
*.rej

# Backup configure.in
configure.in.bak

# Python cache
__pycache__/
*.pyc

# Logs de build temporaires
build_err.log
build_out.log
*.debhelper.log

# Config Claude Code locale (personnelle, ne pas committer)
.claude/settings.local.json

**/obj-*-linux-gnu/
**/packaging/debian/.debhelper/
**/packaging/debian/debhelper-build-stamp
**/packaging/debian/*.substvars
**/packaging/debian/files
**/packaging/debian/*dialog/

# Produits dpkg-buildpackage (à côté du dossier source)
**/*.buildinfo
**/*.changes

**/imgui.ini

# Symlink debian -> packaging/debian, aide au build (dpkg-buildpackage attend debian/ à la racine du source). Recréé au build, non versionné.
/gtk3sermo/gtk3sermo_1.0.0/debian

# artefacts de construction (2026-08-15)
/gtk3sermo/SHA256SUMS
/gtk3sermo/gtk3sermo_1.0.0/gtk3sermo.spec
