# Maintainer: haplo-dialog <devel@haplo-dialog.fr>
# Port: GTK3 — haplo-dialog family

pkgname=gtk3dialog
pkgver=1.0.0
pkgrel=1
epoch=
pkgdesc="GTK3 dialog window creator for shell scripts"
arch=('x86_64' 'aarch64')
url="https://haplo-dialog.fr"
license=('GPL-2.0-or-later')
groups=()
depends=('gtk3' 'vte3' 'gtk-layer-shell')
makedepends=('gtk3' 'vte3' 'gtk-layer-shell' 'flex' 'bison' 'autoconf' 'automake' 'pkgconfig')
checkdepends=()
optdepends=()
provides=('gtk3dialog')
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=("$pkgname-$pkgver.tar.gz::https://haplo-dialog.fr/pub/gtk3dialog/$pkgname-$pkgver.tar.gz")
noextract=()
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # Patch de compatibilité si besoin
  :
}

build() {
  cd "$pkgname-$pkgver"
  NOCONFIGURE=1 ./autogen.sh
  ./configure --prefix=/usr \
              --mandir=/usr/share/man \
              
  make
}

check() {
  cd "$pkgname-$pkgver"
  # make check 2>/dev/null || true
  :
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -d "$pkgdir/usr/share/doc/$pkgname/examples"
  cp -r examples/* "$pkgdir/usr/share/doc/$pkgname/examples/" 2>/dev/null || true
}
