#!/usr/bin/make -f
# debian/rules — haplo-dialog 1.0.0 (binaire gtk3dialog)

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_autoreconf:
	NOCONFIGURE=1 ./autogen.sh

override_dh_auto_configure:
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-maintainer-mode \
		
		$(NULL)

override_dh_auto_install:
	dh_auto_install
	rm -f $(CURDIR)/debian/haplo-dialog/usr/share/icons/hicolor/icon-theme.cache
	install -d $(CURDIR)/debian/haplo-dialog/usr/share/doc/haplo-dialog/examples
	cp -r examples/* $(CURDIR)/debian/haplo-dialog/usr/share/doc/haplo-dialog/examples/ 2>/dev/null || true

override_dh_strip:
	dh_strip --dbgsym-migration='gtk3dialog-dbgsym (<< 1.0.0-8~)'

override_dh_auto_test:
	# Suite de tests (Check) désactivée à l'empaquetage — dépendance facultative.
