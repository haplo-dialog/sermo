#!/bin/sh
# searchentry — example for the <searchentry> widget (GtkSearchEntry)
# gtkdialog-1.0.0 — haplo-dialog 2026
#
# The <searchentry> widget is a GtkEntry with a built-in search icon.
# The variable exports the current text. The signal is "search-changed"
# (fired ~150ms after the last keystroke — debounced by GTK).
#
# Usage:
#   ./searchentry          — launch the dialog
#   ./searchentry --dump   — print the XML definition

GTKDIALOG=gtkdialog

MAIN_DIALOG='
<window title="SearchEntry example" resizable="false">
	<vbox>
		<frame GtkSearchEntry — search field with icon>
			<vbox>
				<searchentry>
					<variable>SEARCH_TEXT</variable>
					<default></default>
					<action>echo "Searching for: $SEARCH_TEXT"</action>
					<action>refresh:RESULT_LIST</action>
				</searchentry>
				<list>
					<variable>RESULT_LIST</variable>
					<input>
						for item in alpha beta gamma delta epsilon; do
							echo "$item" | grep -i "$SEARCH_TEXT" && echo "$item"
						done | sort -u
					</input>
				</list>
			</vbox>
		</frame>
		<hbox>
			<button ok></button>
			<button cancel></button>
		</hbox>
	</vbox>
</window>
'
export MAIN_DIALOG

case $1 in
	-d | --dump) echo "$MAIN_DIALOG" ;;
	*) $GTKDIALOG --program=MAIN_DIALOG
	   echo "SEARCH_TEXT=$SEARCH_TEXT"
	   echo "RESULT_LIST=$RESULT_LIST" ;;
esac
