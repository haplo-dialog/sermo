#!/bin/sh
# password — example for the <password> widget (GtkEntry masked)
# gtkdialog-1.0.0 — haplo-dialog 2026
#
# <password> is a GtkEntry with visibility=FALSE.
# An eye icon (secondary) allows toggling display of the characters.
#
# Tag attributes:
#   show-toggle="true|false"   — show/hide eye icon (default: true)
#   placeholder="text"         — hint text in empty field
#   max-length="N"             — max characters
#
# Exported variable: plaintext entered by the user.
# WARNING: never pass the value as a command-line argument.
# Use a pipe or a tmpfs file: echo "$MY_PASS" | somecommand
#
# Usage:
#   ./password            — launch the dialog
#   ./password --dump     — print the XML definition

GTKDIALOG=gtk3dialog

MAIN_DIALOG='
<window title="Password example" resizable="false">
  <vbox spacing="8">

    <frame Saisie securisee>

      <hbox spacing="4">
        <text><label>Utilisateur :</label></text>
        <entry>
          <variable>USERNAME</variable>
          <default>admin</default>
        </entry>
      </hbox>

      <hbox spacing="4">
        <text><label>Mot de passe :</label></text>
        <password placeholder="Entrez votre mot de passe" max-length="64">
          <variable>USER_PASS</variable>
        </password>
      </hbox>

      <hbox spacing="4">
        <text><label>Confirmation :</label></text>
        <password placeholder="Confirmez le mot de passe" show-toggle="false">
          <variable>PASS_CONFIRM</variable>
        </password>
      </hbox>

    </frame>

    <frame Verification>
      <button>
        <label>Vérifier</label>
        <action>
          if [ "$USER_PASS" = "$PASS_CONFIRM" ]; then
            echo "Mots de passe identiques"
          else
            echo "ERREUR : mots de passe différents !"
          fi
        </action>
      </button>
    </frame>

    <hbox>
      <button ok></button>
      <button cancel></button>
    </hbox>

  </vbox>
</window>
'
export MAIN_DIALOG

case $1 in
  -d | --dump) echo "$MAIN_DIALOG" ;;
  *)
    $GTKDIALOG --program=MAIN_DIALOG
    # Ne jamais afficher USER_PASS en clair dans un vrai script
    echo "USERNAME=$USERNAME"
    if [ -n "$USER_PASS" ]; then
      echo "USER_PASS=(non vide, longueur=$(echo -n "$USER_PASS" | wc -c))"
    else
      echo "USER_PASS=(vide)"
    fi
    ;;
esac
