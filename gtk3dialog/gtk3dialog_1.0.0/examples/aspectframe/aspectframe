#!/bin/sh
# aspectframe — example for the <aspectframe> widget (GtkAspectFrame)
# gtkdialog-1.0.0 — haplo-dialog 2026
#
# <aspectframe> is a container that enforces a fixed width/height ratio
# on its child widget. Useful for keeping images or video areas square
# or at a fixed cinema/screen ratio regardless of window resizing.
#
# Tag attributes:
#   ratio="W/H"         — aspect ratio as float (1.0 = square, 1.777 = 16/9)
#                         default: 1.0
#   xalign="0.0..1.0"   — horizontal alignment of child (default: 0.5)
#   yalign="0.0..1.0"   — vertical alignment of child  (default: 0.5)
#   obey-child="true"   — use child's own ratio instead (default: false)
#   label="text"        — optional frame label (like <frame>)
#
# Exported variable: empty string (container, no value)
#
# Usage:
#   ./aspectframe            — launch the dialog
#   ./aspectframe --dump     — print the XML definition

GTKDIALOG=gtk3dialog

MAIN_DIALOG='
<window title="AspectFrame example" default-width="500" resizable="true">
  <vbox spacing="8">

    <frame Comparaison de ratios>
      <hbox spacing="8" homogeneous="true">

        <vbox>
          <text><label>1:1 (carré)</label></text>
          <aspectframe ratio="1.0" label="1:1">
            <image icon-name="dialog-information" icon-size="dialog"></image>
          </aspectframe>
        </vbox>

        <vbox>
          <text><label>16:9 (cinéma)</label></text>
          <aspectframe ratio="1.7777" label="16:9">
            <image icon-name="video-display" icon-size="dialog"></image>
          </aspectframe>
        </vbox>

        <vbox>
          <text><label>4:3 (TV)</label></text>
          <aspectframe ratio="1.3333" label="4:3">
            <image icon-name="computer" icon-size="dialog"></image>
          </aspectframe>
        </vbox>

        <vbox>
          <text><label>Portrait 2:3</label></text>
          <aspectframe ratio="0.6666" label="2:3">
            <image icon-name="user-info" icon-size="dialog"></image>
          </aspectframe>
        </vbox>

      </hbox>
    </frame>

    <frame Alignement dans le cadre>
      <hbox spacing="8" homogeneous="true">

        <aspectframe ratio="2.0" xalign="0.0" yalign="0.5" label="gauche">
          <image icon-name="go-previous" icon-size="dialog"></image>
        </aspectframe>

        <aspectframe ratio="2.0" xalign="0.5" yalign="0.5" label="centre">
          <image icon-name="view-fullscreen" icon-size="dialog"></image>
        </aspectframe>

        <aspectframe ratio="2.0" xalign="1.0" yalign="0.5" label="droite">
          <image icon-name="go-next" icon-size="dialog"></image>
        </aspectframe>

      </hbox>
    </frame>

    <button ok></button>
  </vbox>
</window>
'
export MAIN_DIALOG

case $1 in
  -d | --dump) echo "$MAIN_DIALOG" ;;
  *) $GTKDIALOG --program=MAIN_DIALOG ;;
esac
