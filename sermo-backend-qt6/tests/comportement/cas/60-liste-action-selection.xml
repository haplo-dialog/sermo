<list><variable>L</variable><item>un</item><item>deux</item><action>refresh:CPT</action></list>
<entry><variable>CPT</variable><input>sh donnees/compteur.sh</input></entry>
<timer interval="1" visible="false"><variable>_T</variable><action>exit:fin</action></timer></vbox></window>
