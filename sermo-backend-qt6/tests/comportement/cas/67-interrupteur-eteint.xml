<!-- DESC: interrupteur allume par defaut, eteint par activate: : seule l action if false joue -->
<window><vbox>
<entry><variable>B</variable><default>b</default></entry>
<entry><variable>C</variable><default>c</default></entry>
<switch><variable>SW</variable><default>true</default>
<action>if true clear:B</action><action>if false clear:C</action></switch>
<timer visible="false" interval="2"><variable>_T1</variable><action>activate:SW</action></timer>
<timer visible="false" interval="3"><variable>_T2</variable><action>exit:fin</action></timer>
</vbox></window>
