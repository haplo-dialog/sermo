# Dockerfile.gtk3sermo — Build multi-stage pour gtk3sermo
# haplo-dialog 1.0.0 — haplo-dialog — GPL-2.0-or-later
#
# Usage :
#   docker build -f ci/Dockerfile.gtk3sermo -t haplo-dialog .
#   docker run --rm haplo-dialog gtk3sermo --version
#
# Build headless (tests unitaires) :
#   docker run --rm haplo-dialog make -C /build check

# ── Étape 1 : builder ─────────────────────────────────────────────────────
FROM debian:testing AS builder

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    flex \
    bison \
    pkg-config \
    libgtk-3-dev \
    libglib2.0-dev \
    autoconf \
    automake \
    libtool \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY gtk3sermo/gtk3sermo_1.0.0 .

RUN autoreconf -fi \
    && ./configure \
        --prefix=/usr/local \
        CFLAGS="-O2 -Wall -Wextra \
                -Werror=format-security \
                -D_FORTIFY_SOURCE=3 \
                -D_POSIX_C_SOURCE=200809L \
                -fstack-protector-strong \
                -fstack-clash-protection \
                -fcf-protection=full \
                -fPIE" \
        LDFLAGS="-pie -Wl,-z,relro -Wl,-z,now -Wl,-z,noexecstack" \
    && make -j$(nproc) \
    && make DESTDIR=/install install

# ── Étape 2 : image runtime minimale ──────────────────────────────────────
FROM debian:testing-slim AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libgtk-3-0 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install/usr/local/bin/gtk3sermo /usr/local/bin/gtk3sermo
COPY --from=builder /install/usr/local/share/man /usr/local/share/man

RUN gtk3sermo --version || true

LABEL org.opencontainers.image.title="haplo-dialog gtk3sermo"
LABEL org.opencontainers.image.description="GTK3 dialog box creator for shell scripts"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.licenses="GPL-2.0-or-later"
LABEL org.opencontainers.image.source="https://haplo-dialog.fr"

ENTRYPOINT ["/usr/local/bin/gtk3sermo"]
CMD ["--help"]
