<!-- DESC: deux fenetres ouvertes en meme temps declarent la meme variable : la premiere garde la sienne, la seconde est rangee sous NOM__W<id> -->
<window><vbox>
<entry><variable>NOM</variable><default>un</default></entry>
<progressbar><variable>P</variable><input>echo 100</input><action>launch:SECONDE</action></progressbar>
<timer visible="false" interval="3"><variable>_F</variable><action>exit:fin</action></timer></vbox></window>
