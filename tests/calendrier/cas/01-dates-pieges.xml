<!-- DESC: calendar : la date demandee est posee quel que soit le jour courant (29 fevrier, fins de mois de 30 et 31 jours) -->
<window><vbox>
<calendar><variable>CAL_A</variable><default>2000-02-29</default></calendar>
<calendar><variable>CAL_B</variable><default>2001-04-30</default></calendar>
<calendar><variable>CAL_C</variable><default>2001-02-28</default></calendar>
<calendar><variable>CAL_D</variable><default>1999-12-31</default></calendar>
<calendar><variable>CAL_E</variable><default>2001-03-07</default></calendar>
<timer visible="false"><variable>_T</variable><action>exit:fin</action></timer>
</vbox></window>
