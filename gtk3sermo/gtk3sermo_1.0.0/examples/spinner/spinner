#!/bin/sh
# spinner — example for the <spinner> widget (GtkSpinner)
# gtkdialog-1.0.0 — haplo-dialog 2026
#
# <spinner> shows an animated "busy" indicator.
# Exported variable: "1" (active) or "0" (inactive).
#
# Tag attributes:
#   active="true|false"   — initial state (default: false)
#
# Actions:
#   start:VAR   — start spinning
#   stop:VAR    — stop spinning
#
# <input> accepts: "1"/"true"/"yes" → start ; "0"/"false"/"no" → stop
#
# Usage:
#   ./spinner            — launch the dialog
#   ./spinner --dump     — print the XML definition

GTKDIALOG=gtk3sermo

MAIN_DIALOG='
<window title="Spinner example" resizable="false">
  <vbox spacing="8">

    <frame GtkSpinner — indicateur activite>
      <hbox spacing="8">

        <!-- Spinner démarré au lancement -->
        <vbox>
          <text><label>Actif dès le départ</label></text>
          <spinner active="true">
            <variable>SPIN1</variable>
          </spinner>
        </vbox>

        <vseparator></vseparator>

        <!-- Spinner contrôlé par des boutons -->
        <vbox>
          <text><label>Contrôlé manuellement</label></text>
          <spinner>
            <variable>SPIN2</variable>
          </spinner>
          <hbox>
            <button>
              <label>Démarrer</label>
              <action>start:SPIN2</action>
            </button>
            <button>
              <label>Arrêter</label>
              <action>stop:SPIN2</action>
            </button>
          </hbox>
        </vbox>

        <vseparator></vseparator>

        <!-- Simulation d'une tâche longue -->
        <vbox>
          <text><label>Simulation tâche</label></text>
          <spinner>
            <variable>SPIN3</variable>
          </spinner>
          <button>
            <label>Lancer (3s)</label>
            <action>start:SPIN3</action>
            <action>bash -c "sleep 3" &amp;</action>
            <action>stop:SPIN3</action>
          </button>
        </vbox>

      </hbox>
    </frame>

    <hbox>
      <button ok></button>
      <button cancel></button>
    </hbox>
  </vbox>
</window>
'
export MAIN_DIALOG

case $1 in
  -d | --dump) echo "$MAIN_DIALOG" ;;
  *)
    $GTKDIALOG --program=MAIN_DIALOG
    echo "SPIN1=$SPIN1  SPIN2=$SPIN2  SPIN3=$SPIN3"
    ;;
esac
