pkgname=gtk3sermo
pkgver=1.1.0
pkgrel=1
epoch=
pkgdesc="GTK3 dialog window creator for shell scripts"
arch=('x86_64' 'aarch64')
url="https://haplo-dialog.fr"
license=('GPL-2.0-or-later')
groups=()
depends=('gtk3' 'vte3' 'gtk-layer-shell')
makedepends=('gtk3' 'vte3' 'gtk-layer-shell' 'flex' 'bison' 'autoconf' 'automake' 'pkgconfig' 'texinfo')
checkdepends=()
optdepends=()
provides=('gtk3sermo')
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
# L'archive du tag contient les DEUX ports ; on descend dans celui-ci.
source=("sermo-v$pkgver.tar.gz::https://gitlab.com/haplo-dialog/sermo/-/archive/v1.1.0/sermo-v1.1.0.tar.gz")
_srcdir="sermo-v$pkgver/gtk3sermo/gtk3sermo_$pkgver"
noextract=()
sha256sums=('SKIP')

prepare() {
  cd "$_srcdir"
  # Patch de compatibilité si besoin
  :
}

build() {
  cd "$_srcdir"
  NOCONFIGURE=1 ./autogen.sh
  ./configure --prefix=/usr \
              --mandir=/usr/share/man \
              
  make
}

check() {
  cd "$_srcdir"
  # make check 2>/dev/null || true
  :
}

package() {
  cd "$_srcdir"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -d "$pkgdir/usr/share/doc/$pkgname/examples"
  cp -r examples/* "$pkgdir/usr/share/doc/$pkgname/examples/" 2>/dev/null || true
}
