#!/bin/sh
# vscale — example for the <vscale> widget (GtkScale vertical)
# gtkdialog-1.0.0 — haplo-dialog 2026
#
# <vscale> is the vertical counterpart of <hscale>.
# Both use the same widget_hscale.c implementation (WIDGET_VSCALE type).
# Exported variable: current value as float string.
#
# Tag attributes:
#   range-min="0"   range-max="100"   range-step="1"   range-value="50"
#
# Usage:
#   ./vscale            — launch the dialog
#   ./vscale --dump     — print the XML definition

GTKDIALOG=${GTKDIALOG:-gtk3sermo}

MAIN_DIALOG='
<window title="vscale example" resizable="false">
  <vbox spacing="8">
    <frame Vertical slider — GtkScale>
      <hbox spacing="12" homogeneous="false">

        <vbox>
          <text><label>Volume</label></text>
          <vscale range-min="0" range-max="100" range-step="1" range-value="70">
            <variable>VOLUME</variable>
            <action>refresh:VOLUME_LABEL</action>
          </vscale>
        </vbox>

        <vseparator></vseparator>

        <vbox>
          <text><label>Balance</label></text>
          <vscale range-min="-50" range-max="50" range-step="1" range-value="0">
            <variable>BALANCE</variable>
            <action>refresh:BALANCE_LABEL</action>
          </vscale>
        </vbox>

        <vseparator></vseparator>

        <vbox>
          <text><label>Bass</label></text>
          <vscale range-min="0" range-max="10" range-step="0.5" range-value="5">
            <variable>BASS</variable>
            <action>refresh:BASS_LABEL</action>
          </vscale>
        </vbox>

      </hbox>
    </frame>

    <frame Valeurs courantes>
      <hbox>
        <text><label>Volume :</label></text>
        <text>
          <variable>VOLUME_LABEL</variable>
          <input>echo "$VOLUME"</input>
        </text>
        <text><label>  Balance :</label></text>
        <text>
          <variable>BALANCE_LABEL</variable>
          <input>echo "$BALANCE"</input>
        </text>
        <text><label>  Bass :</label></text>
        <text>
          <variable>BASS_LABEL</variable>
          <input>echo "$BASS"</input>
        </text>
      </hbox>
    </frame>

    <hbox>
      <button ok></button>
      <button cancel></button>
    </hbox>
  </vbox>
</window>
'
export MAIN_DIALOG

case $1 in
  -d | --dump) echo "$MAIN_DIALOG" ;;
  *)
    $GTKDIALOG --program=MAIN_DIALOG
    echo "VOLUME=$VOLUME  BALANCE=$BALANCE  BASS=$BASS"
    ;;
esac
