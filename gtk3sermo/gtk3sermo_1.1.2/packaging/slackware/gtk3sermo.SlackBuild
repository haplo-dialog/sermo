#!/bin/sh
# gtk3sermo.SlackBuild — Slackware packaging for gtk3sermo
# haplo-dialog <devel@haplo-dialog.fr> — https://haplo-dialog.fr
# Toolkit: GTK3

PRGNAM=gtk3sermo
VERSION=${VERSION:-1.1.2}
BUILD=${BUILD:-1}
TAG=${TAG:-_sermo}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    i?86)   ARCH=i586   ;;
    arm*)   ARCH=arm    ;;
    *)      ARCH=$(uname -m) ;;
  esac
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
# L'archive du tag contient les DEUX ports. On la telecharge si elle n'est pas
# deja dans $OUTPUT, puis on descend dans le port de ce SlackBuild.
SRCTAR=$OUTPUT/sermo-v$VERSION.tar.gz
[ -f "$SRCTAR" ] || wget -O "$SRCTAR" \
  "https://gitlab.com/haplo-dialog/sermo/-/archive/v$VERSION/sermo-v$VERSION.tar.gz"
tar xvf "$SRCTAR"
cd sermo-v$VERSION/gtk3sermo/gtk3sermo_$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) \
 -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) \
 -exec chmod 644 {} \;

NOCONFIGURE=1 ./autogen.sh

./configure \
  --prefix=/usr \
  --sysconfdir=/etc \
  --localstatedir=/var \
  --mandir=/usr/man \
  

make ${MAKEFLAGS}
make DESTDIR=$PKG install



# Strip binaries
find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | \
  grep ELF | cut -f 1 -d : | xargs strip --strip-unneeded 2>/dev/null || true

# Man page
if [ -d $PKG/usr/man ]; then
  find $PKG/usr/man -type f -exec gzip -9 {} \;
fi

# Documentation
mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a README NEWS AUTHORS COPYING $PKG/usr/doc/$PRGNAM-$VERSION/ 2>/dev/null || true
if [ -d examples ]; then
  cp -r examples $PKG/usr/doc/$PRGNAM-$VERSION/
fi
cat ${CWD}/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat ${CWD}/slack-desc > $PKG/install/slack-desc
[ -f ${CWD}/doinst.sh ] && cat ${CWD}/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE

echo ""
echo "Package built: $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
